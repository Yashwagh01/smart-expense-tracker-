{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "ai": {
      "root": "smart-expense-tracker/ai",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/api/supabase/(.*)",
      "destination": "https://acemxzyszztshqyyitnf.supabase.co/$1"
    },
    {
      "source": "/api/ai/(.*)",
      "destination": {
        "service": "ai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
