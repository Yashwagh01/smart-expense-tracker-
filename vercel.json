{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "ai",
          "format": "url",
          "env": "AI_URL"
        }
      ]
    },
    "ai": {
      "root": "smart-expense-tracker/ai",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/api/ai/:match*",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
