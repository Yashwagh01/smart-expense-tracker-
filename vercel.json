{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/supabase/(.*)",
      "destination": "https://acemxzyszztshqyyitnf.supabase.co/$1"
    },
    {
      "source": "/api/ai/(.*)",
      "destination": "/api/ai/index.py"
    },
    {
      "source": "/api/ai",
      "destination": "/api/ai/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
